# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_ALLOWED_USER_ID=11111111,22222222

# --- Agent ------------------------------------------------------------------
# codex  — OpenAI Codex CLI via `codex app-server` (streams token by token)
# claude — Claude Agent SDK (the original backend)
AGENT_PROVIDER=codex

# --- Codex ------------------------------------------------------------------
# read-only | workspace-write | danger-full-access
CODEX_SANDBOX_MODE=danger-full-access
# never | on-request | on-failure | untrusted
CODEX_APPROVAL_POLICY=never
# true adds a one-line "🔧 <command>" notice inside the same streamed message.
# Off by default: one message per request, nothing else.
CODEX_TOOL_NOTICES=false
